<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/pvBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pv_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="10dp"
        android:gravity="right"
        android:layoutDirection="rtl"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/pvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/pvWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8sp" />

        <LinearLayout
            android:id="@+id/pvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pvWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi متصل"
                android:textColor="#9FE8FF"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/pvStorage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="التخزين 3.2 / 8.0 GB"
                android:textColor="#9FE8FF"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pvSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_margin="10dp"
        android:paddingBottom="3dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:text="الإعدادات"
        android:textColor="#FFFFFF"
        android:textSize="7sp" />

    <LinearLayout
        android:id="@+id/pvCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:layoutDirection="rtl"
        android:orientation="horizontal" />
</merge>
